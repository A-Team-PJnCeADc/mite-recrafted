{
	"schemaVersion": 1,
	"id": "mite_recrafted",
	"version": "${version}",
	"name": "mite-recrafted",
	"description": "MITE (Minecraft Is Too Easy) mechanics for modern Minecraft.",
	"authors": [
		"abzxc"
	],
	"contact": {
		"homepage": "https://github.com/A-Team-PJnCeADc/mite-recrafted",
		"sources": "https://github.com/A-Team-PJnCeADc/mite-recrafted"
	},
	"license": "CC BY-NC-SA 4.0",
	"icon": "assets/mite_recrafted/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mite.recraft.fabric.MiteRecraftedFabric"
		],
		"fabric-datagen": [
			"com.mite.recraft.fabric.client.MiteRecraftedDataGenerator"
		]
	},
	"mixins": [
		"mite-recrafted.mixins.json",
		{
			"config": "mite-recrafted.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "mite-recrafted-fabric.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"architectury": ">=22.0.3"
	}
}
